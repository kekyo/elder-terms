<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkWindow" id="main_window">
    <property name="visible">False</property>
    <property name="can-focus">False</property>
    <property name="title">elder-terms-vte</property>
    <child type="titlebar">
      <object class="GtkHeaderBar" id="header_bar">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="title">elder-terms-vte</property>
        <property name="show-close-button">True</property>
        <child>
          <object class="GtkButton" id="settings_button">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="tooltip-text" translatable="yes">Settings</property>
            <child>
              <object class="GtkImage" id="settings_button_image">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="icon-name">preferences-system-symbolic</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="pack-type">end</property>
          </packing>
        </child>
        <child>
          <object class="GtkMenuButton" id="transfer_button">
            <property name="visible">False</property>
            <property name="can-focus">True</property>
            <property name="tooltip-text" translatable="yes">Transfer</property>
            <child>
              <object class="GtkImage" id="transfer_button_image">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="icon-name">document-send-symbolic</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="pack-type">end</property>
          </packing>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="root_box">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="terminal_scroller">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <property name="orientation">horizontal</property>
            <child>
              <object class="GtkOverlay" id="terminal_overlay">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <child>
                  <object class="GtkOverlay" id="terminal_surface_overlay">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="hexpand">True</property>
                    <property name="vexpand">True</property>
                    <child>
                      <object class="VteTerminal" id="terminal_view">
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                      </object>
                    </child>
                    <child type="overlay">
                      <object class="GtkEventBox" id="terminal_dim_overlay">
                        <property name="visible">False</property>
                        <property name="no-show-all">True</property>
                        <property name="can-focus">False</property>
                        <property name="visible-window">True</property>
                        <property name="halign">fill</property>
                        <property name="valign">fill</property>
                      </object>
                      <packing>
                        <property name="pass-through">True</property>
                      </packing>
                    </child>
                  </object>
                </child>
                <child type="overlay">
                  <object class="GtkFrame" id="disconnected_notice">
                    <property name="visible">False</property>
                    <property name="no-show-all">True</property>
                    <property name="can-focus">False</property>
                    <property name="halign">end</property>
                    <property name="valign">start</property>
                    <property name="margin-top">10</property>
                    <property name="margin-end">10</property>
                    <property name="shadow-type">out</property>
                    <child>
                      <object class="GtkEventBox" id="disconnected_notice_background">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="visible-window">True</property>
                        <child>
                          <object class="GtkLabel" id="disconnected_notice_label">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="label" translatable="yes">Disconnected</property>
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                            <property name="max-width-chars">64</property>
                            <property name="selectable">True</property>
                            <property name="margin-start">10</property>
                            <property name="margin-end">10</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
	                  <packing>
	                    <property name="pass-through">True</property>
	                  </packing>
	                </child>
                <child type="overlay">
                  <object class="GtkBox" id="transfer_progress_overlay">
                    <property name="visible">False</property>
                    <property name="no-show-all">True</property>
                    <property name="can-focus">False</property>
                    <property name="halign">end</property>
                    <property name="valign">start</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <child>
                      <object class="GtkFrame" id="transfer_progress_notice">
                        <property name="visible">False</property>
                        <property name="no-show-all">True</property>
                        <property name="can-focus">False</property>
                        <property name="halign">end</property>
                        <property name="margin-top">10</property>
                        <property name="margin-end">10</property>
                        <property name="shadow-type">out</property>
                        <child>
                          <object class="GtkEventBox" id="transfer_progress_notice_background">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="visible-window">True</property>
                            <child>
                              <object class="GtkBox" id="transfer_progress_notice_content">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="orientation">vertical</property>
                                <property name="spacing">4</property>
                                <property name="margin-start">10</property>
                                <property name="margin-end">10</property>
                                <property name="margin-top">6</property>
                                <property name="margin-bottom">8</property>
                                <child>
                                  <object class="GtkLabel" id="transfer_progress_notice_label">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="label" translatable="yes">Transferring...</property>
                                    <property name="xalign">0</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">0</property>
                                  </packing>
                                </child>
                                <child>
                                  <object class="GtkProgressBar" id="transfer_progress_bar">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <property name="width-request">150</property>
                                    <property name="pulse-step">0.08</property>
                                  </object>
                                  <packing>
                                    <property name="expand">False</property>
                                    <property name="fill">True</property>
                                    <property name="position">1</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">True</property>
                        <property name="position">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="transfer_cancel_button">
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="receives-default">True</property>
                        <property name="halign">end</property>
                        <property name="margin-end">10</property>
                        <property name="label" translatable="yes">Cancel</property>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">False</property>
                        <property name="position">1</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="pass-through">False</property>
                  </packing>
                </child>
                <child type="overlay">
                  <object class="GtkFrame" id="ssh_prompt_panel">
                    <property name="visible">False</property>
                    <property name="no-show-all">True</property>
                    <property name="can-focus">False</property>
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <property name="width-request">380</property>
                    <property name="shadow-type">out</property>
                    <child>
                      <object class="GtkEventBox" id="ssh_prompt_background">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="visible-window">True</property>
                        <child>
                          <object class="GtkBox" id="ssh_prompt_content">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="orientation">vertical</property>
                            <property name="spacing">10</property>
                            <property name="margin-start">16</property>
                            <property name="margin-end">16</property>
                            <property name="margin-top">14</property>
                            <property name="margin-bottom">14</property>
                            <child>
                              <object class="GtkLabel" id="ssh_prompt_title_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">SSH Authentication</property>
                                <property name="xalign">0</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="ssh_prompt_message_label">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Password:</property>
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                                <property name="max-width-chars">56</property>
                                <property name="selectable">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="ssh_prompt_entry">
                                <property name="visible">False</property>
                                <property name="no-show-all">True</property>
                                <property name="can-focus">True</property>
                                <property name="visibility">False</property>
                                <property name="activates-default">True</property>
                                <property name="hexpand">True</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButtonBox" id="ssh_prompt_actions">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="orientation">horizontal</property>
                                <property name="spacing">8</property>
                                <property name="layout-style">end</property>
                                <child>
                                  <object class="GtkButton" id="ssh_prompt_cancel_button">
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="label" translatable="yes">Cancel</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="ssh_prompt_accept_button">
                                    <property name="visible">True</property>
                                    <property name="can-focus">True</property>
                                    <property name="can-default">True</property>
                                    <property name="receives-default">True</property>
                                    <property name="label" translatable="yes">OK</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
	              </object>
	              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkScrollbar" id="terminal_scrollbar">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="orientation">vertical</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkEventBox" id="status_bar">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="visible-window">True</property>
            <child>
              <object class="GtkBox" id="status_bar_content">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="orientation">horizontal</property>
                <child>
                  <object class="GtkLabel" id="status_label">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="label" translatable="yes">Terminal</property>
                    <property name="xalign">0</property>
                    <property name="ellipsize">end</property>
                    <property name="margin-start">8</property>
                    <property name="margin-top">2</property>
                    <property name="margin-bottom">2</property>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkBox" id="activity_indicator_bar">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <property name="halign">end</property>
                    <property name="valign">center</property>
                    <property name="margin-end">8</property>
                    <property name="margin-top">2</property>
                    <property name="margin-bottom">2</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                    <property name="fill">False</property>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkLabel" id="fixture_grid_size_label">
            <property name="visible">False</property>
            <property name="no-show-all">True</property>
            <property name="can-focus">False</property>
            <property name="label">0x0</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
            <property name="position">2</property>
          </packing>
        </child>
        <child>
          <object class="GtkLabel" id="fixture_scrollback_lines_label">
            <property name="visible">False</property>
            <property name="no-show-all">True</property>
            <property name="can-focus">False</property>
            <property name="label">0</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">False</property>
            <property name="position">3</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
