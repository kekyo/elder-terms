<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkListStore" id="connection_store">
    <columns>
      <column type="gchararray"/>
      <column type="gchararray"/>
      <column type="gboolean"/>
    </columns>
  </object>
  <object class="GtkWindow" id="main_window">
    <property name="visible">False</property>
    <property name="can-focus">False</property>
    <property name="title">elder-terms</property>
    <property name="default-width">900</property>
    <property name="default-height">560</property>
    <child type="titlebar">
      <object class="GtkHeaderBar" id="header_bar">
        <property name="visible">True</property>
        <property name="title">elder-terms</property>
        <property name="show-close-button">True</property>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="root_box">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkPaned" id="split_pane">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>
            <property name="position">260</property>
            <property name="wide-handle">True</property>
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <child>
              <object class="GtkScrolledWindow" id="connection_scroller">
                <property name="visible">True</property>
                <property name="width-request">180</property>
                <property name="hscrollbar-policy">never</property>
                <property name="vscrollbar-policy">automatic</property>
                <child>
                  <object class="GtkTreeView" id="connection_list">
                    <property name="visible">True</property>
                    <property name="can-focus">True</property>
                    <property name="headers-visible">False</property>
                    <property name="model">connection_store</property>
                    <child internal-child="selection">
                      <object class="GtkTreeSelection" id="connection_selection">
                        <property name="mode">single</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkTreeViewColumn" id="connection_name_column">
                        <property name="expand">True</property>
                        <child>
                          <object class="GtkCellRendererText" id="connection_name_renderer">
                            <property name="editable">False</property>
                          </object>
                          <attributes>
                            <attribute name="text">0</attribute>
                          </attributes>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
              <packing>
                <property name="resize">False</property>
                <property name="shrink">False</property>
              </packing>
            </child>
            <child>
              <object class="GtkStack" id="details_stack">
                <property name="visible">True</property>
                <property name="transition-type">crossfade</property>
                <child>
                  <object class="GtkLabel" id="empty_details_label">
                    <property name="visible">True</property>
                    <property name="label">Select a connection or create a new one.</property>
                  </object>
                  <packing>
                    <property name="name">empty</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkBox" id="settings_container">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                  </object>
                  <packing>
                    <property name="name">settings</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="resize">True</property>
                <property name="shrink">False</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox" id="action_row">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">10</property>
            <property name="margin-bottom">10</property>
            <child>
              <object class="GtkButton" id="new_button">
                <property name="visible">True</property>
                <property name="label">New</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="action_spacer">
                <property name="visible">True</property>
                <property name="hexpand">True</property>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="apply_button">
                <property name="visible">True</property>
                <property name="sensitive">False</property>
                <property name="label">Apply</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="connect_button">
                <property name="visible">True</property>
                <property name="sensitive">False</property>
                <property name="label">Connect</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
