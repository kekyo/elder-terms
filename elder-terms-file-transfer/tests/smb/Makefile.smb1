ROOT := $(abspath ../../..)
BUILD_DIR := $(ROOT)/.build/smb1-probe
SDK := $(ROOT)/.build/libdsm/sdk
CXXFLAGS := -std=c++20 -Wall -Wextra -Wpedantic -Werror -g

.PHONY: deps build test test-client build-winxp test-winxp
deps:
	node $(ROOT)/scripts/prepare-libdsm.mts $(ROOT) $(ROOT)/.build
build: deps
	mkdir -p $(BUILD_DIR)
	$(CXX) $(CXXFLAGS) -I$(SDK)/include smb1-library-probe.cpp -L$(SDK)/lib -ldsm -Wl,-rpath,$(SDK)/lib -o $(BUILD_DIR)/smb1-library-probe
test: build
	node run-smb1-library.mts $(BUILD_DIR)/smb1-library-probe
test-client: build
	$(CXX) $(CXXFLAGS) -pthread -DCARDIO_WITH_GLIB=1 -DCARDIO_WITH_GIO=1 -I$(ROOT)/deps/cardio/include -I$(SDK)/include $$(pkg-config --cflags gio-unix-2.0) ../../src/smb/smb1-worker.cpp -L$(SDK)/lib -ldsm $$(pkg-config --libs gio-unix-2.0) -Wl,-rpath,$(SDK)/lib -o $(BUILD_DIR)/elder-terms-smb1-worker
	$(CXX) $(CXXFLAGS) -pthread -DCARDIO_WITH_GLIB=1 -DCARDIO_WITH_GIO=1 -I$(ROOT)/deps/cardio/include -I$(ROOT)/shared/include $$(pkg-config --cflags gio-2.0) smb1-client-test.cpp ../../src/file-transfer/file-transfer-engine.cpp ../../src/smb/smb1-client.cpp ../../src/smb/smb-client.cpp ../../src/smb/smb-share-list.cpp -I$(ROOT)/.build/libsmb2/sdk/include -L$(ROOT)/.build/libsmb2/sdk/lib -lsmb2 -Wl,-rpath,$(ROOT)/.build/libsmb2/sdk/lib $$(pkg-config --libs gio-2.0) -o $(BUILD_DIR)/smb1-client-test
	node run-smb1-library.mts $(BUILD_DIR)/smb1-client-test --client
	node run-smb1-fault.mts $(BUILD_DIR)/smb1-client-test

build-winxp:
	mkdir -p $(BUILD_DIR)
	i686-w64-mingw32-gcc -std=c99 -Wall -Wextra -Wpedantic -Werror -municode -static windows-xp-fixture.c -lnetapi32 -ladvapi32 -o $(BUILD_DIR)/windows-xp-fixture.exe

test-winxp: build-winxp
	meson compile -C $(ROOT)/.build
	node run-winxp.mts
